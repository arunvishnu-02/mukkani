# With a domain name in SITE_ADDRESS, Caddy gets and renews the HTTPS certificate by itself.
# HTTPS matters here: phones only share GPS location with https sites.
{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:3000
}

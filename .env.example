# MySQL database (on Hostinger: hPanel > Databases > MySQL). Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://mukkani:mukkani@localhost:3306/mukkani"
# Long random string that signs the login cookie (32+ characters)
SESSION_SECRET="change-me-to-a-long-random-string-32-chars-or-more"
# The address people open, used in location links
APP_URL="http://localhost:3000"
# Password for the first admin (username "admin"), created on first start when no admin exists
ADMIN_PASSWORD=""
# "true" on a live https site so the login cookie is only sent over https
COOKIE_SECURE=""
# Set to "off" to skip OpenStreetMap address lookup
REVERSE_GEOCODE=""
